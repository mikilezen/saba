# Copy to .env and fill in freshly rotated keys on your computer.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Optional structured public-page summaries in the browser agent.
BROWSER_AGENT_GEMINI_MODEL=gemini-3.8-flash
# Optional typed next-action selection for the browser agent.
TYPESAFE_API_KEY=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_MODEL=gemini-2.5-flash
# Optional Google Search results provider; costs SearchAPI credits when enabled.
SEARCHAPI_ENABLED=false
SEARCHAPI_API_KEY=
SEARCHAPI_ENGINE=google
SABA_DATA_DIR=data
# Supabase Postgres connection string for server-side use. Leave empty for local SQLite development.
SUPABASE_DB_URL=
VAPI_AUTO_CALL_ENABLED=false
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_MAX_CALLS_PER_DAY=3
# Telnyx inbound Voice API call control
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
